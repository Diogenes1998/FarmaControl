# ============================================================
# FarmaControl · variables de entorno
# 1. Copia este archivo y renómbralo a: .env
# 2. Completa tus datos. El archivo .env NUNCA se sube a GitHub (.gitignore).
# ============================================================

# ---------- Servidor Express ----------
PORT=3000

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# La contraseña de tu MySQL (en XAMPP suele quedar vacía)
DB_PASSWORD=
DB_NAME=drogueria_db

# ---------- Google Gemini (Google AI Studio) ----------
# Crea tu clave gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo a usar. Si Google lo retira, cámbialo por uno vigente
# (lista: https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite
# Límite de tokens de cada respuesta del modelo
GEMINI_MAX_TOKENS=1024
